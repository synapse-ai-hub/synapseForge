# Groq API Key
GROQ_API_KEY=tu_api_key_aqui

# Modo (dev | prod)
MODE=dev
VITE_MODE=dev

# API URL (para desarrollo y producción)
URL_DEV=http://localhost:8000
URL_PROD=https://tudominio.com
VITE_URL_DEV=http://localhost:8000
VITE_URL_PROD=https://tudominio.com

# DB
SQLSERVER_HOST=tu_host_aqui
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=tu_base_de_datos
SQLSERVER_USER=tu_usuario_aqui
SQLSERVER_PASSWORD=tu_contraseña_aqui

# Email Integration (Ferozo / DonWeb)
# EMAIL_ENABLED=true
# EMAIL_IMAP_SERVER=mail.tudominio.com
# EMAIL_IMAP_PORT=993
# EMAIL_SMTP_SERVER=mail.tudominio.com
# EMAIL_SMTP_PORT=587
# EMAIL_USER=correo@tudominio.com
# EMAIL_PASS=tu_contraseña
# EMAIL_POLL_INTERVAL=30
# EMAIL_FOLDER=INBOX

# Telegram Bot
TELEGRAM_BOT_TOKEN=tu_token_de_telegram
TELEGRAM_CHAT_ID=tu_chat_id
# Whitelist de chat_ids autorizados (separados por coma). Solo estos pueden usar el bot.
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
